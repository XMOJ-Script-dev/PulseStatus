{
  "name": "pulsestatus",
  "version": "1.0.0",
  "description": "Static GitHub Issues-powered status page",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate-config": "tsx scripts/validate-config.ts",
    "sync-issues": "tsx scripts/sync-issues.ts",
    "sync-discussions": "tsx scripts/sync-discussions.ts",
    "check-services": "tsx scripts/check-services.ts",
    "auto-publish-incidents": "tsx scripts/auto-publish-incidents.ts",
    "build-data": "tsx scripts/build-public-data.ts",
    "generate-badges": "tsx scripts/generate-badges.ts",
    "lock-incidents": "tsx scripts/lock-incidents.ts"
  },
  "keywords": ["statuspage", "github-pages"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
